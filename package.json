{
    "name": "@trh/lens",
    "description": "Type-safe lens library for deep data access, mutation, and immutable updates via a proxy-based path DSL",
    "keywords": [
        "lens",
        "immutable",
        "deep",
        "proxy",
        "path",
        "functional",
        "traversal"
    ],
    "license": "UNLICENSE",
    "version": "1.0.1",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RobMayer/trh-lens.git"
    },
    "scripts": {
        "build": "tsdown src/*.ts",
        "clean": "rm -rf ./dist",
        "lint": "tsc"
    },
    "files": [
        "./dist"
    ],
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "packageManager": "pnpm@10.6.4+sha512.da3d715bfd22a9a105e6e8088cfc7826699332ded60c423b14ec613a185f1602206702ff0fe4c438cb15c979081ce4cb02568e364b15174503a63c7a8e2a5f6c",
    "devDependencies": {
        "tsdown": "^0.22.14",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@trh/symbols": "^2.0.1"
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "esbuild"
        ],
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
